# groot.yaml: copy to groot.yaml and adjust. Every field is optional; missing
# fields use the defaults shown here. Strings support ${VAR} and
# ${VAR:-default} expansion. Never write API keys in this file: store the
# Anthropic key with `groot auth login`, or set ANTHROPIC_API_KEY in the
# environment or in a .env file.

provider:
  name: anthropic                # only "anthropic" in this release
  model: ${GROOT_MODEL:-claude-sonnet-5-5}
  # effort: high                 # low | medium | high | xhigh | max. Unset: not sent,
  #                              # so the model's own default applies. An agent's
  #                              # effort overrides this value.

max_turns: 20                    # model calls allowed per user request

compaction:
  strategy: summarize            # none | window | summarize (default: summarize)
  keep: 40                       # window: messages kept (strategy window)
  threshold: 60                  # summarize: history length that triggers a summary

memory:
  path: .groot/groot.db          # relative: each space's own database under its
                                 # directory; absolute: one database shared by all spaces

audit:
  path: .groot/audit.jsonl       # relative: each space's own log under its directory;
                                 # absolute: one log shared by all spaces

gate:
  policy: interactive            # interactive: ask for writes and commands
                                 # readonly: allow reads only
                                 # auto: allow everything (trusted scripts only)

kubectl:
  # Allowlist of namespaces. Empty means any namespace. When set, the model
  # must name one of these namespaces and cannot use -A.
  namespaces: ["${GROOT_NAMESPACE:-}"]

bash:
  sandbox:
    mode: auto                   # auto | strict | off
    network: true                # on by default; a space can turn it off with /space network off
    # extra_writable: [/opt/cache]     # absolute paths the commands may write
    # cache_dirs: [~/.cache, ~/.npm]   # tool caches the commands may write; "~" is expanded.
    #                                  # Unset: $XDG_CACHE_HOME or ~/.cache, ~/.npm, ~/Library/Caches
    #                                  # (macOS), $GOCACHE and the Go module cache ($GOMODCACHE,
    #                                  # else $GOPATH/pkg/mod, else ~/go/pkg/mod). A list here replaces the defaults.

# Optional. Replaces the built-in SRE system prompt.
# system_prompt: |
#   You are Groot, a careful SRE assistant for the payments platform.
